{
  "info": {
    "_postman_id": "lumisshow-api-v1",
    "name": "LumisShow API",
    "description": "LumisShow 백엔드 API 테스트 컬렉션\n\n## 권장 실행 순서\n1. [Auth] Admin 로그인 → `adminToken` 자동 저장\n2. [Admin/Browse] 폴더 탐색으로 실제 photoRelPath 확인\n3. [Admin/Albums] 앨범 생성 → `albumId` 자동 저장\n4. [Admin/Links] 공유 링크 생성 → `shareToken`, `linkId` 자동 저장\n5. [Viewer] 공유 뷰어 인증 → `share_session` 쿠키 자동 저장\n6. [Viewer] 사진 목록 → URL 확인 후 photoAbsPath 설정\n7. [Media] 썸네일/원본/음악 접근\n\n## 컬렉션 변수 (설정 필요)\n- `photoRelPath` : PHOTO_ROOT 기준 상대경로 (예: 2024/album/sample.jpg)\n- `photoAbsPath` : Share Photos 응답의 url 경로 뒤 부분",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",       "value": "http://localhost:8080", "type": "string" },
    { "key": "adminPassword", "value": "dev_password",          "type": "string" },
    { "key": "adminToken",    "value": "",                      "type": "string" },
    { "key": "albumId",       "value": "1",                     "type": "string" },
    { "key": "linkId",        "value": "1",                     "type": "string" },
    { "key": "shareToken",    "value": "",                      "type": "string" },
    { "key": "photoRelPath",  "value": "sample.jpg",            "type": "string" },
    { "key": "photoAbsPath",  "value": "sample.jpg",            "type": "string" }
  ],
  "item": [

    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Admin 로그인",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "    var json = pm.response.json();",
                "    pm.collectionVariables.set('adminToken', json.access_token);",
                "    console.log('adminToken saved');",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Admin 패스워드로 로그인. 성공 시 adminToken 변수에 JWT 자동 저장."
          }
        },
        {
          "name": "내 정보 조회",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "현재 JWT 토큰의 유효성 및 사용자 정보 확인."
          }
        },
        {
          "name": "로그아웃",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },

    {
      "name": "📁 Admin - 파일 탐색",
      "item": [
        {
          "name": "폴더 탐색 (루트)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/browse",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "browse"]
            },
            "description": "PHOTO_ROOT 최상위 폴더 및 이미지 목록. path 파라미터 없으면 루트."
          }
        },
        {
          "name": "폴더 탐색 (서브폴더)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/browse?path=2024",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "browse"],
              "query": [{ "key": "path", "value": "2024", "description": "PHOTO_ROOT 기준 상대 경로" }]
            }
          }
        },
        {
          "name": "파일 검색",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/search?q=&page=1&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "search"],
              "query": [
                { "key": "q",         "value": "",    "description": "파일명 검색어" },
                { "key": "date_from", "value": "",    "description": "YYYY-MM-DD", "disabled": true },
                { "key": "date_to",   "value": "",    "description": "YYYY-MM-DD", "disabled": true },
                { "key": "folder",    "value": "",    "description": "검색 시작 폴더", "disabled": true },
                { "key": "page",      "value": "1" },
                { "key": "size",      "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Admin 썸네일 조회",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/thumb?path={{photoRelPath}}&size=small",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "thumb"],
              "query": [
                { "key": "path", "value": "{{photoRelPath}}", "description": "PHOTO_ROOT 기준 상대경로" },
                { "key": "size", "value": "small",            "description": "small | medium" }
              ]
            },
            "description": "Browse/Search에서 확인한 photoRelPath를 컬렉션 변수에 설정 후 사용."
          }
        }
      ]
    },

    {
      "name": "📚 Admin - 앨범 관리",
      "item": [
        {
          "name": "앨범 목록 조회",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/albums",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "albums"]
            }
          }
        },
        {
          "name": "앨범 생성",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "    pm.collectionVariables.set('albumId', pm.response.json().id.toString());",
                "    console.log('albumId saved:', pm.collectionVariables.get('albumId'));",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"테스트 앨범\",\n  \"description\": \"Postman 테스트용 앨범\",\n  \"photo_paths\": []\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/albums",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "albums"]
            },
            "description": "생성 성공 시 albumId 자동 저장. photo_paths에 Browse로 확인한 경로 추가 가능."
          }
        },
        {
          "name": "앨범 상세 조회",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/albums/{{albumId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "albums", "{{albumId}}"]
            }
          }
        },
        {
          "name": "앨범 수정",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"수정된 앨범명\",\n  \"description\": \"수정된 설명\",\n  \"music_path\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/albums/{{albumId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "albums", "{{albumId}}"]
            }
          }
        },
        {
          "name": "사진 추가",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"photo_paths\": [\"{{photoAbsPath}}\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/albums/{{albumId}}/photos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "albums", "{{albumId}}", "photos"]
            },
            "description": "photoAbsPath에 실제 파일의 절대 경로 또는 Browse 응답의 path 값 사용."
          }
        },
        {
          "name": "사진 제거",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"photo_paths\": [\"{{photoAbsPath}}\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/albums/{{albumId}}/photos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "albums", "{{albumId}}", "photos"]
            }
          }
        },
        {
          "name": "사진 순서 변경",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orders\": [\n    { \"id\": 1, \"sort_order\": 0 },\n    { \"id\": 2, \"sort_order\": 1 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/albums/{{albumId}}/photos/order",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "albums", "{{albumId}}", "photos", "order"]
            },
            "description": "앨범 상세 조회에서 확인한 photo id 값으로 orders 배열 구성."
          }
        },
        {
          "name": "앨범 삭제",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/albums/{{albumId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "albums", "{{albumId}}"]
            },
            "description": "⚠️ 연결된 공유 링크와 사진 목록도 함께 삭제됨 (CASCADE)."
          }
        }
      ]
    },

    {
      "name": "🔗 Admin - 공유 링크 관리",
      "item": [
        {
          "name": "링크 목록 조회",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/albums/{{albumId}}/links",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "albums", "{{albumId}}", "links"]
            }
          }
        },
        {
          "name": "공유 링크 생성",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "    var json = pm.response.json();",
                "    pm.collectionVariables.set('linkId', json.id.toString());",
                "    pm.collectionVariables.set('shareToken', json.token);",
                "    console.log('shareToken saved:', json.token);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": null,\n  \"expires_at\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/albums/{{albumId}}/links",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "albums", "{{albumId}}", "links"]
            },
            "description": "생성 성공 시 linkId, shareToken 자동 저장.\n패스워드 설정 예: `\"password\": \"mysecret\"`\n만료일 설정 예: `\"expires_at\": \"2026-12-31T23:59:59\"`"
          }
        },
        {
          "name": "공유 링크 수정 (비활성화)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/albums/{{albumId}}/links/{{linkId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "albums", "{{albumId}}", "links", "{{linkId}}"]
            },
            "description": "is_active, expires_at, password 중 원하는 필드만 전송."
          }
        },
        {
          "name": "공유 링크 삭제",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/albums/{{albumId}}/links/{{linkId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "albums", "{{albumId}}", "links", "{{linkId}}"]
            }
          }
        }
      ]
    },

    {
      "name": "👁️ Public - 공유 뷰어",
      "item": [
        {
          "name": "링크 정보 (패스워드 필요 여부)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/share/{{shareToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "share", "{{shareToken}}"]
            },
            "description": "인증 없이 접근 가능. requires_password 필드로 패스워드 입력 폼 표시 여부 결정."
          }
        },
        {
          "name": "뷰어 인증 (패스워드 없음)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/share/{{shareToken}}/auth",
              "host": ["{{baseUrl}}"],
              "path": ["api", "share", "{{shareToken}}", "auth"]
            },
            "description": "성공 시 httpOnly `share_session` 쿠키 발급. Postman이 쿠키 자동 저장."
          }
        },
        {
          "name": "뷰어 인증 (패스워드 있음)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"mysecret\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/share/{{shareToken}}/auth",
              "host": ["{{baseUrl}}"],
              "path": ["api", "share", "{{shareToken}}", "auth"]
            }
          }
        },
        {
          "name": "앨범 정보 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/share/{{shareToken}}/album",
              "host": ["{{baseUrl}}"],
              "path": ["api", "share", "{{shareToken}}", "album"]
            },
            "description": "share_session 쿠키 필요. 인증 먼저 실행할 것."
          }
        },
        {
          "name": "사진 목록 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/share/{{shareToken}}/photos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "share", "{{shareToken}}", "photos"]
            },
            "description": "응답의 url, thumb_small_url, thumb_medium_url 경로를 Media 엔드포인트 테스트에 활용."
          }
        }
      ]
    },

    {
      "name": "🖼️ Media 서빙",
      "item": [
        {
          "name": "썸네일 (small)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/thumb/{{photoAbsPath}}?size=small",
              "host": ["{{baseUrl}}"],
              "path": ["thumb", "{{photoAbsPath}}"],
              "query": [{ "key": "size", "value": "small" }]
            },
            "description": "share_session 쿠키 필요.\nphotoAbsPath: Share Photos 응답의 thumb_small_url 에서 /thumb/ 이후 부분 (?size=small 제외) 사용.\n예) /thumb/testdata/photos/img.jpg?size=small → photoAbsPath = testdata/photos/img.jpg"
          }
        },
        {
          "name": "썸네일 (medium)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/thumb/{{photoAbsPath}}?size=medium",
              "host": ["{{baseUrl}}"],
              "path": ["thumb", "{{photoAbsPath}}"],
              "query": [{ "key": "size", "value": "medium" }]
            }
          }
        },
        {
          "name": "원본 이미지",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/media/{{photoAbsPath}}",
              "host": ["{{baseUrl}}"],
              "path": ["media", "{{photoAbsPath}}"]
            },
            "description": "share_session 쿠키 필요.\nphotoAbsPath: Share Photos 응답의 url에서 /media/ 이후 부분 사용."
          }
        },
        {
          "name": "배경음악",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/music/{{shareToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["music", "{{shareToken}}"]
            },
            "description": "share_session 쿠키 필요. 앨범에 music_path가 설정된 경우에만 200 반환."
          }
        }
      ]
    },

    {
      "name": "⚙️ System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Frontend (SPA 진입점)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "frontend/index.html 반환. Phase 2 완성 전까지 placeholder 표시."
          }
        },
        {
          "name": "API 문서 (Swagger)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/docs",
              "host": ["{{baseUrl}}"],
              "path": ["docs"]
            },
            "description": "FastAPI 자동 생성 Swagger UI."
          }
        },
        {
          "name": "OpenAPI 스펙",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/openapi.json",
              "host": ["{{baseUrl}}"],
              "path": ["openapi.json"]
            }
          }
        }
      ]
    }

  ]
}
