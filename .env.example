# Admin 패스워드 — 둘 중 하나 선택 (자세한 내용 → doc/admin-password-guide.md)
#
# [권장] bcrypt 해시: docker inspect에 평문이 노출되지 않음
# ADMIN_PASSWORD_HASH=$2b$12$...
#
# [개발/테스트 전용] 평문: 로컬 개발 환경에서만 사용
ADMIN_PASSWORD=dev_password

JWT_SECRET=dev_secret_key_change_me
PHOTO_ROOT=./testdata/photos
DATA_DIR=./testdata/data
BASE_URL=http://localhost:8080
APP_PORT=8080

# ── AI 워커 (lumisshow-ai, Phase 2) — 미설정 시 기본값 사용 ──
# TZ=Asia/Seoul               # 야간 자동 스캔 시각 기준 타임존
# AI_SCAN_HOUR=2              # 야간 자동 스캔 시각 (0~23)
# AI_MATCH_THRESHOLD=0.45     # 얼굴 매칭 임계값 (eval로 튜닝된 값)
